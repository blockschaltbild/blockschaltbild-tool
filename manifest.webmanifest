{
    "name": "Blockschaltbild Editor",
    "short_name": "Blockschaltbild",
    "description": "Blockschaltbild-Tool für Veranstaltungstechnik: Geräte, Verbindungen, Signalprüfung und PDF-Export.",
    "id": "./",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "orientation": "landscape",
    "background_color": "#ffffff",
    "theme_color": "#4d49bc",
    "lang": "de",
    "icons": [
        { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "file_handlers": [
        {
            "action": "./index.html",
            "accept": { "application/json": [".ict", ".json"] }
        }
    ]
}
